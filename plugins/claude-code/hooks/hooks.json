{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "fi hook claude SessionStart",
            "timeout": 5,
            "async": true
          }
        ]
      }
